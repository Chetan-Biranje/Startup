        "operation": "send",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "YOUR_OWNER_WHATSAPP",
        "textBody": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "a1ae4823-c664-4c7c-8740-74423af2956a",
      "name": "WhatsApp owner",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $('Below reorder level').first().json.items.map(i => ({ json: { SKU: i.SKU, 'Last alert': $now.setZone('Asia/Kolkata').toFormat('yyyy-LL-dd') } }));"
      },
