        },
        "options": {}
      },
      "id": "ba7c7fd8-5b14-4fd2-a656-3a0c15739cc8",
      "name": "Staff",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Tasks tab: Date (yyyy-mm-dd), Task, Assigned to, Priority (high/normal), Where / notes\n// Staff tab: Name, Phone\nconst P = Object.fromEntries($('Staff').all().map(i => [String(i.json.Name).trim(), i.json.Phone]));\nconst g = {};\nfor (const { json: t } of $('Today\\'s tasks').all()) if (t.Task && t['Assigned to']) (g[String(t['Assigned to']).trim()] ||= []).push({ task: t.Task, priority: t.Priority || 'normal', notes: t['Where / notes'] || '' });\nreturn Object.entries(g).filter(([n]) => P[n]).map(([name, tasks]) => ({ json: { name, phone: P[name], tasks } }));"
      },
      "id": "6fa884e3-c365-4bd3-a2c8-ebbc9bd0ea25",
      "name": "Group by person",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a morning WhatsApp to {{ $json.name }}, a staff member of YOUR BUSINESS NAME, with today's tasks: {{ JSON.stringify($json.tasks) }}\nFormat: 'Good morning {{ $json.name }} ☀️ Your tasks today:' then numbered tasks, high priority first marked ⚡, with the notes in brackets. End with 'Reply DONE <number> when finished.' Simple English, max 10 lines, no extra tasks. Output only the message.",
        "hasOutputParser": false
      },
      "id": "95f9136b-e240-40f4-9ff5-1cbdb6066b42",
      "name": "AI writes task list",
