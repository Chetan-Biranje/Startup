      ]
    },
    {
      "parameters": {
        "jsCode": "const g = $('Group by person').all().map(i => i.json);\nreturn [{ json: { text: `✅ Tasks sent to ${g.length} people:\\n` + g.map(p => `• ${p.name}: ${p.tasks.length} task(s)`).join('\\n') } }];"
      },
