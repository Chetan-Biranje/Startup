        "operation": "send",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $('Find employee').item.json.Phone }}",
        "textBody": "=Hi {{ $('Find employee').item.json.Name }}, I'm the leave bot 🙂 To ask for leave just write it, e.g. \"Sick leave tomorrow, fever\" or \"Leave 3 to 5 Nov for a family function\".",
        "additionalFields": {}
      },
      "id": "1cede3c8-d3f6-47a8-9fed-a72d9bd0ea4a",
