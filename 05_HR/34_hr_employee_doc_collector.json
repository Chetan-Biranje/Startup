    },
    {
      "parameters": {
        "jsCode": "// Employees tab: Name, Phone, Required (comma list, e.g. Aadhaar, PAN, Photo, BankPassbook), Received, Last doc, Pending\nconst e = $('Find employee').first().json;\nconst got = $('AI tags document').first().json.output.doc_type;\nconst req = String(e.Required || 'Aadhaar, PAN, Photo, BankPassbook').split(',').map(s => s.trim()).filter(Boolean);\nconst rec = new Set(String(e.Received || '').split(',').map(s => s.trim()).filter(Boolean)); rec.add(got);\nconst pending = req.filter(d => !rec.has(d));\nreturn [{ json: { Phone: e.Phone, Received: [...rec].join(', '), 'Last doc': got, Pending: pending.join(', ') || 'none',\n  reply: `✅ ${got} received, ${e.Name}. Saved safely.\\n` + (pending.length ? `Still needed: *${pending.join(', ')}*` : 'All your joining documents are in 🎉 Thank you!') } }];"
      },
      "id": "76cebc90-9814-42e7-92a6-4df94df909c8",
      "name": "What's pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
