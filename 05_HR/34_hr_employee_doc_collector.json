      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=A new employee sent a joining document on WhatsApp.\nFile name: {{ $('Staff WhatsApp').item.json.messages?.[0]?.document?.filename || 'photo' }}\nCaption: {{ $('Staff WhatsApp').item.json.messages?.[0]?.document?.caption || $('Staff WhatsApp').item.json.messages?.[0]?.image?.caption || '' }}\nPick doc_type from: Aadhaar, PAN, Photo, BankPassbook, EducationCertificate, ExperienceLetter, RelievingLetter, AddressProof, Other.",
        "hasOutputParser": true
      },
