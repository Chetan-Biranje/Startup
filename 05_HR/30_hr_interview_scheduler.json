        },
        "returnAll": true,
        "timeMin": "={{ $now.setZone('Asia/Kolkata').plus({ days: 1 }).startOf('day').toISO() }}",
        "timeMax": "={{ $now.setZone('Asia/Kolkata').plus({ days: 6 }).endOf('day').toISO() }}",
        "options": {
          "singleEvents": true
        }
      },
      "id": "087da54f-5c7a-4d45-afb1-5bf7eb08f4fc",
      "name": "Busy times (next 5 days)",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        480,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Candidates tab: Name, Email, Phone, Role, Status (shortlisted -> invited), Interview\n// Interview slots: weekdays at these times (IST), 45 minutes each. Edit to suit you.\nconst TIMES = ['11:00', '12:30', '15:00', '16:30'];\nconst MINUTES = 45;\nconst busy = $('Busy times (next 5 days)').all().map(i => i.json).filter(e => e.start?.dateTime)\n  .map(e => [DateTime.fromISO(e.start.dateTime), DateTime.fromISO(e.end.dateTime)]);\nconst slots = [];\nfor (let d = 1; d <= 6; d++) {\n  const day = $now.setZone('Asia/Kolkata').plus({ days: d }).startOf('day');\n  if (day.weekday === 7) continue; // no Sundays\n  for (const t of TIMES) {\n    const [h, m] = t.split(':').map(Number);\n    const s = day.set({ hour: h, minute: m }), e = s.plus({ minutes: MINUTES });\n    if (!busy.some(([bs, be]) => s < be && e > bs)) slots.push([s, e]);\n  }\n}\nconst cands = $('Shortlisted candidates').all().map(i => i.json).filter(r => r.Email && r.Name);\nreturn cands.slice(0, slots.length).map((r, i) => ({ json: { ...r, start: slots[i][0].toISO(), end: slots[i][1].toISO(),\n  when: slots[i][0].toFormat(\"cccc, d LLL 'at' h:mm a\") } }));"
      },
      "id": "3853a662-0252-44d4-a22a-7d563faa94b8",
      "name": "Pick free slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short, friendly interview invitation email from YOUR BUSINESS NAME.\nCandidate: {{ $json.Name }}\nRole: {{ $json.Role }}\nInterview: {{ $json.when }} IST, 45 minutes, Google Meet (link in the calendar invite).\n\nsubject: max 8 words. body: 4-6 short lines: greeting 'Hello {{ $json.Name }}', the role, the time, that the Google Meet link is in the calendar invite, ask them to reply if the time does not suit them, sign off 'Team YOUR BUSINESS NAME'. Do not mention salary or promise a job.",
        "hasOutputParser": true
      },
      "id": "2271fefc-a54a-4d38-bc93-3d1c09c185b6",
      "name": "AI writes invite",
