      "id": "b95d67da-164e-4fba-bc3e-827892750c60",
      "name": "Joiners",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Joiners tab: Name, Phone, Role, Joining date (yyyy-mm-dd), Manager, Manager phone, Status (onboarding/done), Last sent\nconst today = $now.setZone('Asia/Kolkata').startOf('day');\nconst ck = $('Your checklists').first().json;\nconst MAP = { 0: 'day1', 2: 'day3', 6: 'day7' };\nconst out = [];\nfor (const { json: r } of $input.all()) {\n  if (!r.Phone || !r['Joining date']) continue;\n  const d = Math.round(today.diff(DateTime.fromISO(r['Joining date'], { zone: 'Asia/Kolkata' }).startOf('day'), 'days').days);\n  if (!(d in MAP) || r['Last sent'] === MAP[d]) continue;\n  out.push({ json: { ...r, step: MAP[d], checklist: ck[MAP[d]], company: ck.company } });\n}\nreturn out;"
      },
      "id": "7c46def1-e0cc-4f38-8bcf-a6b57c703fc9",
      "name": "Day 1 / 3 / 7 today?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write two short WhatsApp messages for a new employee's onboarding at {{ $json.company }}.\nEmployee: {{ $json.Name }}, role {{ $json.Role }}, manager {{ $json.Manager }}.\nToday is their {{ $json.step === 'day1' ? 'first day' : $json.step === 'day3' ? 'third day' : 'seventh day' }}. Today's checklist: {{ $json.checklist }}\n\nto_joiner: warm and simple (max 5 lines), greet 'Hello {{ $json.Name }}', the checklist as 2-4 short bullet points, one encouraging line. to_manager: 2 lines reminding {{ $json.Manager }} what to do with {{ $json.Name }} today. Simple English. Do not promise salary, leave or perks.",
        "hasOutputParser": true
      },
      "id": "f3364593-762c-4957-af4c-08d797a65f53",
      "name": "AI writes welcome",
