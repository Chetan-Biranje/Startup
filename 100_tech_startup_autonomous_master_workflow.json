{
  "name": "100 Tech Startup Autonomous Master Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tech-startup-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "tech-master-inbound",
      "name": "Webhook: Tech Inbound Order/Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || $json;\nconst evtType = b.event_type || b.type || \"new_signup\";\nconst customerPhone = b.phone || b.customer_phone || \"\";\nconst customerEmail = b.email || b.customer_email || \"\";\nconst plan = b.plan || \"Developer Scale\";\nconst amount = b.amount || 99;\nconst monthlyCredit = b.credits || 100000;\nconst name = b.name || \"Developer\";\n\nreturn {\n  json: {\n    evtType,\n    customerPhone,\n    customerEmail,\n    name,\n    plan,\n    amount,\n    monthlyCredit,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "tech-parse-payload",
      "name": "Parse Event & Plan Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\nconst apiKey = \"sk_live_\" + Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);\nconst workspaceId = \"ws_\" + Math.random().toString(36).substring(2, 10);\n\nreturn {\n  json: {\n    ...item,\n    apiKey,\n    workspaceId,\n    status: \"ACTIVATED\",\n    environment: \"production\"\n  }\n};\n"
      },
      "id": "tech-gen-creds",
      "name": "Generate API Key & Workspace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the AI Developer Onboarding Concierge for Tech Startup Cloud.\nA new customer signed up:\nName: {{$json.name}}\nPlan: {{$json.plan}}\nAPI Key: {{$json.apiKey}}\nWorkspace ID: {{$json.workspaceId}}\nCredits: {{$json.monthlyCredit}}\n\nWrite an onboarding greeting with their credentials and quickstart instructions.\nReturn a JSON object: {\"welcome_message\": \"...\", \"onboarding_status\": \"Ready\"}"
      },
      "id": "tech-llm-onboard",
      "name": "Gemini: Personalized Onboarding",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const orig = $(\"Generate API Key & Workspace\").item.json;\nconst welcomeMsg = `Welcome to our AI Cloud, ${orig.name}! Your workspace ${orig.workspaceId} is active. Your API Key is: ${orig.apiKey}`;\nconst messageFormatted = `🚀 *Welcome to Tech Startup Platform!* 🚀\\n\\n👤 *Name:* ${orig.name}\\n🔑 *API Key:* ${orig.apiKey}\\n🏢 *Workspace:* ${orig.workspaceId}\\n📦 *Tier:* ${orig.plan} (${orig.monthlyCredit.toLocaleString()} credits)\\n\\n📖 *Quickstart Guide:* https://docs.yourstartup.io/quickstart`;\n\nreturn {\n  json: {\n    ...orig,\n    welcomeMsg,\n    messageFormatted\n  }\n};\n"
      },
      "id": "tech-format-msg",
      "name": "Format WhatsApp & Email Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/{{$env.WHATSAPP_PHONE_NUMBER_ID}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.META_WHATSAPP_ACCESS_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{$json.customerPhone}}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": {{$json.messageFormatted}} }\n}"
      },
      "id": "tech-send-whatsapp",
      "name": "WhatsApp API Key & Welcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.GOOGLE_SHEET_DATABASE_ID}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Organizations"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{$json.timestamp}}",
            "Customer_Name": "={{$json.name}}",
            "Email": "={{$json.customerEmail}}",
            "Phone": "={{$json.customerPhone}}",
            "Plan_Tier": "={{$json.plan}}",
            "Workspace_ID": "={{$json.workspaceId}}",
            "API_Key_Prefix": "={{$json.apiKey.substring(0, 12)}}...",
            "Status": "={{$json.status}}"
          }
        }
      },
      "id": "tech-log-sheet",
      "name": "Log To Central Database / Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1420,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"message\": \"Workspace provisioned and credentials dispatched.\",\n  \"workspaceId\": \"{{$json.workspaceId}}\",\n  \"tier\": \"{{$json.plan}}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "tech-respond-webhook",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1640,
        300
      ]
    }
  ],
  "connections": {
    "Webhook: Tech Inbound Order/Event": {
      "main": [
        [
          {
            "node": "Parse Event & Plan Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Event & Plan Details": {
      "main": [
        [
          {
            "node": "Generate API Key & Workspace",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate API Key & Workspace": {
      "main": [
        [
          {
            "node": "Gemini: Personalized Onboarding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini: Personalized Onboarding": {
      "main": [
        [
          {
            "node": "Format WhatsApp & Email Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format WhatsApp & Email Alert": {
      "main": [
        [
          {
            "node": "WhatsApp API Key & Welcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp API Key & Welcome": {
      "main": [
        [
          {
            "node": "Log To Central Database / Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log To Central Database / Sheet": {
      "main": [
        [
          {
            "node": "Respond 200 OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
