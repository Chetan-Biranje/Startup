        },
        "options": {}
      },
      "id": "dbf9a79f-def2-484f-99a4-10e80fe19f70",
      "name": "Price dropped?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2160,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "=YOUR_OWNER_WHATSAPP",
        "textBody": "=📉 Price drop: *{{ $('Parse ₹ + compare').item.json.Product }}*\n₹{{ $('Parse ₹ + compare').item.json.last }} → ₹{{ $('Parse ₹ + compare').item.json.price }}{{ $('Parse ₹ + compare').item.json.hit_target ? ' (below your target!)' : '' }}\n{{ $('Parse ₹ + compare').item.json.URL }}",
        "additionalFields": {}
      },
      "id": "3c86e9bd-eebc-4967-8557-89fbc16d02d9",
      "name": "WhatsApp owner",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        2400,
        0
      ]
    }
