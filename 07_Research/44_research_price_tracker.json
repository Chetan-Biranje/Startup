            "Product"
          ],
          "schema": []
        },
        "options": {}
      },
      "id": "3d7925ca-dfa8-4803-bc41-5049655a9664",
      "name": "Update track list",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
