    {
      "parameters": {
        "jsCode": "const m = $json.messages?.[0];\nif (!m?.text?.body) return null;\nreturn { json: { channel: 'whatsapp', chat: m.from, text: m.text.body } };",
        "mode": "runOnceForEachItem"
      },
