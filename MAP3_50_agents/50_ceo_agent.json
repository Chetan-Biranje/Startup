    {
      "parameters": {
        "jsCode": "const num = v => Number(String(v ?? '').replace(/[^0-9.-]/g, '')) || 0;\nconst y = $now.setZone('Asia/Kolkata').minus({ days: 1 }).toFormat('yyyy-LL-dd'), t = $now.setZone('Asia/Kolkata').toFormat('yyyy-LL-dd');\nconst rows = n => $(n).all().map(i => i.json);\nconst on = (a, d) => a.filter(r => String(r.Date || r.Created || r.Received || r.Added || '').slice(0, 10) === d);\nconst S = on(rows('Sales'), y), E = on(rows('Expenses'), y);\nreturn [{ json: { date: $now.setZone('Asia/Kolkata').minus({ days: 1 }).toFormat('d LLL'), sales: S.reduce((s, r) => s + num(r.Amount), 0), bills: S.length, spent: E.reduce((s, r) => s + num(r.Amount), 0),\n  new_leads: on(rows('Leads'), y).length, open_tickets: rows('Tickets').filter(r => r.Status && !/closed|resolved|done/i.test(r.Status)).length,\n  tasks_today: on(rows('Tasks'), t).length, low_stock: rows('Stock').filter(r => r.SKU && num(r['In stock']) <= num(r['Reorder level'])).map(r => r.Item).slice(0, 8) } }];"
      },
      "id": "56213740-2cff-4c8d-a8b9-589a48b7afbf",
