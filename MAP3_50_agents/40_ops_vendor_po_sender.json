    {
      "parameters": {
        "jsCode": "const rows = $('PO row').all().map(i => i.json);\nreturn [{ json: { text: `🧾 ${rows.length} purchase order draft(s) ready in Gmail:\\n` + rows.map(r => `• ${r.PO} ${r.Vendor}: ${r.Items}`).join('\\n') + '\\nCheck and send them.' } }];"
      },
