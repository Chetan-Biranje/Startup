          "mode": "name",
          "value": "Stock"
        },
        "options": {}
      },
      "id": "6cea911e-5e93-4218-a3dd-0d4fa33ae355",
      "name": "Stock",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "YOUR_GOOGLE_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Vendors"
        },
        "options": {}
      },
      "id": "d8fed901-2172-4727-b928-d3cb317d5f13",
      "name": "Vendors",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        480,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Stock tab: SKU, Item, In stock, Reorder level, Order qty, Unit, Vendor, Last price\n// Vendors tab: Vendor, Contact, Email, Phone\nconst num = v => Number(String(v ?? '').replace(/[^0-9.-]/g, '')) || 0;\nconst V = Object.fromEntries($('Vendors').all().map(i => [i.json.Vendor, i.json]));\nconst low = $('Stock').all().map(i => i.json).filter(r => r.SKU && r.Vendor && num(r['In stock']) <= num(r['Reorder level']));\nconst groups = {};\nfor (const r of low) (groups[r.Vendor] ||= []).push({ SKU: r.SKU, Item: r.Item, qty: num(r['Order qty']) || num(r['Reorder level']) * 2, unit: r.Unit || 'pcs', rate: num(r['Last price']) });\nconst stamp = $now.setZone('Asia/Kolkata').toFormat('yyMMdd');\nreturn Object.entries(groups).filter(([v]) => V[v]?.Email).map(([v, items], i) => ({ json: { po: `PO-${stamp}-${String(i + 1).padStart(2, '0')}`, vendor: v,\n  contact: V[v].Contact || v, email: V[v].Email, items, total: items.reduce((s, x) => s + x.qty * x.rate, 0) } }));"
      },
      "id": "b5e4e03e-be70-4e46-bb05-7458f3f4f489",
      "name": "Group by vendor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a purchase order email from YOUR BUSINESS NAME to a supplier.\nPO number: {{ $json.po }}\nSupplier: {{ $json.vendor }} (contact {{ $json.contact }})\nItems (qty, unit, last rate ₹): {{ JSON.stringify($json.items) }}\nEstimated total at last rates: ₹{{ $json.total }}\n\nsubject: 'Purchase Order {{ $json.po }} – YOUR BUSINESS NAME'. body: polite, simple English: greeting, the item list as numbered lines (item, qty, unit), 'rates as per our last bill unless you tell us otherwise', ask them to confirm availability and delivery date by reply, sign off 'Thanks, YOUR BUSINESS NAME'. Exact quantities only. Do not ask for discounts or promise payment terms.",
        "hasOutputParser": true
      },
      "id": "00b0d621-30a6-480d-9d7b-272b90baf304",
      "name": "AI writes PO email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "e6875328-9736-496c-bb04-49dd1f16d47f",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        900,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"subject\": \"Purchase Order PO-261102-01 – YOUR BUSINESS NAME\",\n  \"body\": \"Dear Ramesh ji, ...\"\n}"
      },
      "id": "1a991239-96b0-4711-ad69-3fdf49c44b37",
      "name": "JSON shape",
