        }
      },
      "id": "79b82709-eb87-43ba-866a-7a2bace96200",
      "name": "Draft PO email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1340,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const g = $('Group by vendor').item.json;\nreturn { json: { PO: g.po, Date: $now.setZone('Asia/Kolkata').toFormat('yyyy-LL-dd'), Vendor: g.vendor, Items: g.items.map(x => `${x.Item} x${x.qty}`).join(', '), 'Est. total': g.total, Status: 'draft' } };",
        "mode": "runOnceForEachItem"
      },
      "id": "d64133a1-adb4-47f2-9845-8cf681de9a98",
      "name": "PO row",
