        "path": "next-customer",
        "options": {}
      },
      "id": "e87fe8af-6a0a-4903-84f7-cbd47dbdebbf",
      "name": "Next customer button",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "YOUR_GOOGLE_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Tokens"
        },
        "options": {},
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Date",
              "lookupValue": "={{ $now.setZone('Asia/Kolkata').toFormat('yyyy-LL-dd') }}"
            }
          ]
        }
      },
      "id": "dc7b5779-0006-48ad-9ce9-d4ec398284f5",
      "name": "Today's tokens",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// body: { \"token\": 12 } = the token being served now. Alert the customer who is next and the one 2 away.\n// Tokens tab: Date (yyyy-mm-dd), Token, Name, Phone, Service, Status\nconst now = Number($('Next customer button').first().json.body.token);\nconst rows = $input.all().map(i => i.json).filter(r => r.Token);\nconst out = [];\nfor (const r of rows) {\n  const gap = Number(r.Token) - now;\n  if (gap === 1) out.push({ ...r, Status: 'alerted: next', msg: `⏰ Hello ${r.Name} ji, you are NEXT (token #${r.Token}) at YOUR BUSINESS NAME. Please come to the counter.` });\n  if (gap === 2) out.push({ ...r, Status: 'alerted: 2 away', msg: `Hello ${r.Name} ji, only 1 customer is before you (token #${r.Token}). Please reach YOUR BUSINESS NAME in about 10 minutes 🙏` });\n  if (Number(r.Token) === now) out.push({ ...r, Status: 'serving', msg: '' });\n}\nreturn out.map(json => ({ json }));"
      },
      "id": "60ca112e-37b4-44ed-b592-4acdde672a15",
      "name": "Who to alert",
