        "subject": "=Recap: {{ $('Paste transcript').first().json['Meeting title'] }}",
        "message": "={{ $('AI writes notes').first().json.output.follow_up_email }}\n\nFull notes: https://docs.google.com/document/d/{{ $('Create Google Doc').first().json.id }}",
        "options": {
          "sendTo": "={{ $('Paste transcript').first().json['Attendee emails (comma separated)'] }}"
        }
      },
      "id": "c8b02c54-159c-4204-9671-69f197a247fd",
