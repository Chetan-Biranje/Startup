      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"offer_line\": \"This Diwali, get 10% off on all sweet boxes above ₹999 at our shop 🪔\",\n  \"preview\": \"Hello Rahul ji, ...\"\n}"
      },
      "id": "7f850c40-277f-4b8e-974a-761254112a82",
      "name": "JSON shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
