    },
    {
      "parameters": {
        "jsCode": "// Festivals tab: Date (yyyy-mm-dd), Festival, Offer (written by YOU), Audience tag (blank = everyone)\nreturn $input.all().filter(i => i.json.Festival && i.json.Offer);"
      },
      "id": "d5d3e39e-8810-4e6c-952c-b0d1f2806c88",
      "name": "Has an offer?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Festival: {{ $json.Festival }} (on {{ $json.Date }}). The owner's offer, exactly: \"{{ $json.Offer }}\".\nWrite offer_line: ONE warm festive line (max 140 characters, max 1 emoji) that announces exactly this offer for a WhatsApp template variable. Copy numbers, ₹ amounts and dates exactly from the owner's offer; do not add any other discount, free gift, deadline or condition. No line breaks.\nAlso write preview: how the full message will read for a customer named Rahul.",
        "hasOutputParser": true
      },
      "id": "6603fe8f-48ad-41dc-ab18-19a0cb682c79",
      "name": "AI writes offer line",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0.6
        }
      },
      "id": "0b3ca83d-b279-49cf-b6bf-fea237445b6c",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        660,
