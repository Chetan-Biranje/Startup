      "id": "55705465-30f3-4737-b3ed-7f09a57112b9",
      "name": "Opted-in customers",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1580,
        -80
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const norm = p => { const d = String(p || '').replace(/\\D/g, '');\n  if (d.length === 10) return '91' + d; if (d.length === 11 && d[0] === '0') return '91' + d.slice(1);\n  return d.length >= 11 && d.length <= 15 ? d : ''; }; // 10-digit Indian mobile -> 91XXXXXXXXXX\n// Customers tab: Name, Phone, Opt-in (yes/no), Tags\nconst f = $('Has an offer?').first().json;\nconst line = $('AI writes offer line').first().json.output.offer_line;\nconst tag = String(f['Audience tag'] || '').trim();\nconst seen = new Set();\nreturn $input.all().map(i => i.json).filter(r => String(r['Opt-in']).toLowerCase() === 'yes' && (!tag || String(r.Tags || '').includes(tag)))\n  .map(r => ({ ...r, phone: norm(r.Phone) })).filter(r => r.phone && !seen.has(r.phone) && seen.add(r.phone))\n  .map(r => ({ json: { name: String(r.Name || 'there').split(' ')[0], phone: r.phone, festival: f.Festival, offer_line: line } }));"
      },
      "id": "d3c7667f-552d-4889-8e66-531fccfd089b",
      "name": "Build sends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        -80
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendTemplate",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "template": "YOUR_TEMPLATE_NAME|en",
        "components": {
          "component": [
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  {
                    "type": "text",
                    "text": "={{ $json.name }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.festival }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.offer_line }}"
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "5c0894b0-4466-4a2e-8d11-cdb6e685dca7",
      "name": "Send WhatsApp template",
