              "lookupValue": "new"
            }
          ]
        }
      },
      "id": "70c14f72-6014-44d7-bf22-5eefb43f71bf",
      "name": "New products",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write shop listing copy for this product of YOUR BUSINESS NAME.\nProduct: {{ $json.Product }}\nCategory: {{ $json.Category }}\nPrice: ₹{{ $json.Price }}\nOwner's notes / features: {{ $json.Features }}\n\ntitle: max 70 characters (product + 1-2 key features). description: 60-100 words, simple English, short sentences, a bullet list of the features. caption: an Instagram/WhatsApp Status caption, max 3 lines, 1-2 emojis, ends with 'Order on WhatsApp'. hashtags: 5-8 relevant hashtags.\nUse ONLY the features in the notes. Do not invent sizes, materials, certifications, warranties, 'best', '100% original' or delivery promises. Price exactly as given, no discounts.",
        "hasOutputParser": true
      },
      "id": "b7b1a948-6e06-42b2-8175-caf1182d90f5",
      "name": "AI writes listing",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0.6
        }
      },
      "id": "4f4c1fb9-b1a2-47d5-b99a-27fa27c00176",
      "name": "AI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        420,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"title\": \"Handloom Cotton Saree – Pochampally Ikat, Maroon\",\n  \"description\": \"...\",\n  \"caption\": \"...\",\n  \"hashtags\": \"#pochampally #ikat\"\n}"
      },
      "id": "d2db363e-ac96-4e68-8bb0-1d4203b0af2f",
      "name": "JSON shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        620,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const o = $json.output;\nreturn { json: { SKU: $('New products').item.json.SKU, Title: o.title, Description: o.description, Caption: o.caption, Hashtags: o.hashtags,\n  Status: 'ready for review', Updated: $now.setZone('Asia/Kolkata').toFormat('yyyy-LL-dd HH:mm') } };",
        "mode": "runOnceForEachItem"
      },
      "id": "af04d270-09bf-4fd7-80d0-5afb4762c3bd",
